[Unit]
Description=shopapi Spring Boot (SELinux PaC demo — no vendor policy)
After=network.target auditd.service
Wants=auditd.service

[Service]
Type=simple
User=shopapi
Group=shopapi
EnvironmentFile=-/etc/shopapi.env
WorkingDirectory=/opt/shopapi
Environment=JAVA_HOME=/opt/shopapi
# Private copy of the JRE launcher at /opt/shopapi/bin/java is labeled
# shopapi_exec_t. /usr/bin/java is shared java_exec_t and 203/EXEC under enforcing.
SELinuxContext=system_u:system_r:shopapi_t:s0
ExecStart=/opt/shopapi/bin/java -jar /opt/shopapi/shopapi.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=false
StateDirectory=shopapi
LogsDirectory=shopapi
RuntimeDirectory=shopapi

[Install]
WantedBy=multi-user.target
