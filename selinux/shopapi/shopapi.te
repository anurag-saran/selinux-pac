policy_module(shopapi, 1.0.1)

#############################################
# Types-only seed for the Spring Boot demo app.
#
# Scaffold entry point on RHEL: scripts/scaffold_sepolicy_module.sh shopapi shopapi_t
# (sepolicy-generate). Do not copy myapp or payments allows into this file.
# Allows come from observed AVCs via scripts/dev_generate_policy.sh after the
# service runs permissive. If process execmem never appears in that log, do
# not add it (needs_review if it does).
#
# Live start: ExecStart is /opt/shopapi/bin/shopapi (shopapi_exec_t).
# init_daemon_domain transitions init_t, which is an initrc_domain
# (init.te calls init_initrc_domain(init_t)), when that file is executed.
# https://github.com/fedora-selinux/selinux-policy/blob/c9s/policy/modules/system/init.if
# The wrapper execs /usr/bin/java. On RHEL 9 the JVM file is bin_t:
# java_exec_t is an alias of bin_t in the base corecommands module. The
# generator writes corecmd_exec_bin(shopapi_t) only because
# config/shopapi.manifest.yml records the reviewed selinux_exceptions.exec_bin.
# Do not hand-write it, and never a raw allow on bin_t. It is not an entrypoint.
# The unit has no SELinuxContext= line. The java process type is shopapi_t.
# The host commands are in docs/LIVE_CHECKS.md.
#############################################

type shopapi_t;
type shopapi_exec_t;
type shopapi_lib_t;
type shopapi_var_lib_t;
type shopapi_var_run_t;
type shopapi_log_t;
type shopapi_port_t;

files_type(shopapi_exec_t)
files_type(shopapi_lib_t)
files_type(shopapi_var_lib_t)
files_pid_file(shopapi_var_run_t)
logging_log_file(shopapi_log_t)
corenet_port(shopapi_port_t)

init_daemon_domain(shopapi_t, shopapi_exec_t)
init_daemon_run_dir(shopapi_var_run_t, "shopapi")

########################################
# Generated by deterministic_gen.py (reproducible for identical inputs).
# avc-sha256-prefix: 3a5b1c1a912c79d3
# refpolicy-devel:     selinux-policy-devel-38.1.75-2.el9_8.1.noarch
# selinux-policy-rpm:  selinux-policy-targeted-38.1.75-2.el9_8.1.noarch
# policy-version:      33
# policy-kern:         /var/lib/selinux/targeted/active/policy.kern
########################################

# Needs review (domain-weakening permissions; --allow-needs-review)
# Security decision (needs review): the AVC log showed this permission was denied. It is not a labeling miss. The proposed allow is recorded in findings.json / pr_summary.md but is not written to the .te unless you pass --allow-needs-review (or --allow-needs-review-perm). process:execmem allows map memory as both writable and executable. It weakens the domain because it breaks W^X: memory the process can write, it can also execute. Alternatives: this AVC showed process execmem was denied. Some JVM/runtime configurations avoid writable+executable mappings; do not assume a JVM needs execmem. Confirm empirically for this workload and its options before --allow-needs-review.
allow shopapi_t self:process execmem;

# Refpolicy interfaces
corecmd_exec_bin(shopapi_t)
corenet_tcp_bind_generic_node(shopapi_t)
dev_read_urand(shopapi_t)
dev_read_rand(shopapi_t)
files_manage_generic_tmp_dirs(shopapi_t)
files_map_generic_tmp_files(shopapi_t)
files_manage_generic_tmp_files(shopapi_t)
kernel_read_network_state(shopapi_t)
kernel_read_network_state_symlinks(shopapi_t)
kernel_read_system_state(shopapi_t)

# Module-private / direct access
gen_require(`
	type shell_exec_t;
	type sssd_public_t;
	type sssd_var_lib_t;
	type sysfs_t;
')
allow shopapi_t shell_exec_t:file { execute map };
allow shopapi_t shopapi_lib_t:file { getattr open read };
allow shopapi_t shopapi_log_t:dir { getattr search };
allow shopapi_t shopapi_log_t:file open;
allow shopapi_t shopapi_port_t:tcp_socket { name_bind name_connect };
allow shopapi_t shopapi_t:tcp_socket { accept bind connect create getattr getopt ioctl listen read setopt shutdown write };
allow shopapi_t shopapi_t:udp_socket { create ioctl };
allow shopapi_t shopapi_var_lib_t:dir { getattr search };
allow shopapi_t shopapi_var_lib_t:file { append open };
allow shopapi_t sssd_public_t:dir { search };
allow shopapi_t sssd_var_lib_t:dir { search };
allow shopapi_t sysfs_t:dir { read };
allow shopapi_t sysfs_t:file { getattr open read };
list_dirs_pattern(shopapi_t, shopapi_lib_t, shopapi_lib_t)
